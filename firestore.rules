rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function hasActiveAccess() {
      return isSignedIn() && (
        request.auth.token.access == 'active' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accessStatus == 'active')
      );
    }

    function isAllowedCaseStatus(status) {
      return status in ['draft', 'processing', 'review', 'ready', 'published'];
    }

    function isValidCaseUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'clientLabel',
        'sources',
        'draft',
        'selectedVariant',
        'branding',
        'status',
        'modifiedFields',
        'consentConfirmed',
        'updatedAt'
      ]) &&
      request.resource.data.ownerId == resource.data.ownerId &&
      isAllowedCaseStatus(request.resource.data.status);
    }

    function isValidCaseCreate() {
      return request.resource.data.ownerId == request.auth.uid &&
        isAllowedCaseStatus(request.resource.data.status) &&
        !('evidences' in request.resource.data) &&
        !('transcript' in request.resource.data) &&
        !('chatExtractions' in request.resource.data) &&
        !('failReason' in request.resource.data) &&
        !('stageMessage' in request.resource.data) &&
        !('stageProgress' in request.resource.data);
    }

    function isValidUserUpdate() {
      return request.resource.data.accessStatus == resource.data.accessStatus &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'profile',
          'consent',
          'updatedAt'
        ]);
    }

    function isValidBetaSignupCreate() {
      let data = request.resource.data;
      let hasValidContact = (
        (('email' in data) && data.email is string && data.email.size() > 0) ||
        (('telegramUsername' in data) && data.telegramUsername is string && data.telegramUsername.size() > 0)
      );

      let isWeb = data.source == 'web' &&
        hasValidContact &&
        (!('email' in data) || data.email == null || data.email is string) &&
        (!('telegramUsername' in data) || data.telegramUsername == null || data.telegramUsername is string) &&
        (!('businessType' in data) || data.businessType is string) &&
        (!('casesVolume' in data) || data.casesVolume is string) &&
        (!('currentProcess' in data) || data.currentProcess is string) &&
        data.consent == true;

      let isTelegram = data.source == 'telegram' &&
        (data.telegramUserId is int || data.telegramUserId is number) &&
        (!('telegramUsername' in data) || data.telegramUsername == null || data.telegramUsername is string) &&
        (!('businessType' in data) || data.businessType is string) &&
        (!('casesVolume' in data) || data.casesVolume is string) &&
        (!('feedbackText' in data) || data.feedbackText is string) &&
        (!('deepLink' in data) || data.deepLink is string) &&
        (!('unsubscribed' in data) || data.unsubscribed is bool) &&
        data.consent is bool;

      return isWeb || isTelegram;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUserUpdate();
      allow create, delete: if false;
    }

    match /cases/{caseId} {
      allow read: if isOwner(resource.data.ownerId) && hasActiveAccess();
      allow create: if isSignedIn() && hasActiveAccess() && isValidCaseCreate();
      allow update: if isOwner(resource.data.ownerId) && hasActiveAccess() && isValidCaseUpdate();
      allow delete: if isOwner(resource.data.ownerId) && hasActiveAccess();

      match /{subcollection}/{docId=**} {
        allow read, write: if isSignedIn() &&
          hasActiveAccess() &&
          get(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid;
      }
    }

    match /invites/{code} {
      allow read, write: if false;
    }

    match /telegram_link_tokens/{token} {
      allow read, write: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /events/{eventId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /beta_signups/{signupId} {
      allow create: if isValidBetaSignupCreate();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
