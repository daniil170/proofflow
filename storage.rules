rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasActiveAccess() {
      return isSignedIn() && (
        request.auth.token.access == 'active' ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.accessStatus == 'active')
      );
    }

    function isCaseOwner(caseId) {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/cases/$(caseId)) &&
        firestore.get(/databases/(default)/documents/cases/$(caseId)).data.ownerId == request.auth.uid;
    }

    function isAllowedSize() {
      return request.resource.size <= 104857600;
    }

    function isAllowedMimeType() {
      return request.resource.contentType.matches('^(image/(png|jpeg|webp|svg\\+xml)|audio/(mpeg|mp3|wav|webm|ogg|m4a|x-m4a|mp4)|video/(mp4|webm|quicktime))$');
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /cases/{caseId}/{allPaths=**} {
      allow read: if isCaseOwner(caseId) && hasActiveAccess();
      allow create, update: if isCaseOwner(caseId) && hasActiveAccess() && isAllowedSize() && isAllowedMimeType();
      allow delete: if isCaseOwner(caseId) && hasActiveAccess();
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId && hasActiveAccess() && request.resource.size <= 5242880 && request.resource.contentType.matches('^image/(png|jpeg|webp|svg\\+xml)$');
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
