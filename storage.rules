rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCaseOwner(caseId) {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/cases/$(caseId)) &&
        firestore.get(/databases/(default)/documents/cases/$(caseId)).data.ownerId == request.auth.uid;
    }

    function isAllowedSize() {
      return request.resource.size <= 104857600;
    }

    function isAllowedMimeType() {
      return request.resource.contentType.matches('^(image/(png|jpeg|webp)|audio/(mpeg|mp3|wav|webm|ogg|m4a|x-m4a|mp4)|video/(mp4|webm|quicktime))$');
    }

    match /cases/{caseId}/{allPaths=**} {
      allow read: if isCaseOwner(caseId);
      allow create, update: if isCaseOwner(caseId) && isAllowedSize() && isAllowedMimeType();
      allow delete: if isCaseOwner(caseId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
