# Production Cloud Functions: use Secret Manager
# firebase functions:secrets:set OPENAI_API_KEY
# firebase functions:secrets:set ANTHROPIC_API_KEY
# firebase functions:secrets:set GEMINI_API_KEY

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
STORAGE_BUCKET=
APP_BASE_URL=https://proofflow.app
USE_MOCK_ADAPTERS=false
DEFAULT_NOTIFICATION_EMAIL=
MAX_CASES_PER_ACCOUNT=3
MAX_RECORDING_DURATION_SEC=1200
FFMPEG_PATH=
FFPROBE_PATH=

# AI Provider Switching (defaults: openai / anthropic / anthropic)
TRANSCRIBER_PROVIDER=openai
CHAT_READER_PROVIDER=anthropic
ANALYZER_PROVIDER=anthropic

# Gemini Configuration (Vertex AI or API mode)
GEMINI_MODE=vertex
GEMINI_REGION=us-central1
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIER=pay-as-you-go
GEMINI_API_KEY=

# Google Speech-to-Text Configuration
GOOGLE_SPEECH_REGION=
GOOGLE_SPEECH_LANGUAGE=ru-RU
